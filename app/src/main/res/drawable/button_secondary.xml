<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#24B5F219">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="@color/disabled_container" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/surface_high" />
                    <corners android:radius="28dp" />
                    <stroke android:width="1dp" android:color="@color/outline" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
